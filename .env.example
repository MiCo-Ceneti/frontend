# URL du backend Django (cote serveur uniquement, jamais exposee au navigateur)
BACKEND_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Firebase Cloud Messaging (notifications push web)
#
# Ces valeurs se trouvent dans la console Firebase :
#   Parametres du projet > General > Vos applications > Application Web
# La VAPID key se trouve dans :
#   Parametres du projet > Cloud Messaging > Certificats push Web
#
# Tant que ces variables sont vides, l'application fonctionne normalement :
# le push est simplement desactive (les notifications in-app restent actives).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
